# bootstrap.sh copies this template and replaces CHANGE_ME values with generated secrets.
COMPOSE_PROJECT_NAME=classification
LOCAL_UID=1000
LOCAL_GID=1000
POSTGRES_PORT=5433
MLFLOW_PORT=5000
API_PORT=8000
STREAMLIT_PORT=8501
JUPYTER_PORT=8889
AIRFLOW_PORT=8080
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
APP_DB_NAME=classification
APP_DB_USER=classification
APP_DB_PASSWORD=CHANGE_ME_APP
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=CHANGE_ME_MLFLOW
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_AIRFLOW
JUPYTER_TOKEN=CHANGE_ME_JUPYTER
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET
AIRFLOW_JWT_SECRET=CHANGE_ME_JWT
MLFLOW_TRACKING_URI=http://mlflow:5000
API_BASE_URL=http://api:8000
MODEL_URI=
